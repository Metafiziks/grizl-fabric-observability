# Copy to fabric/config/grizl.fabric.env and edit for your tenant.
# Do not put secrets in this file.

# Required for auth/account validation and documentation.
FABRIC_TENANT_ID=

# Existing/manual GRIZL Fabric resource names.
FABRIC_WORKSPACE_NAME=grizl-stream
FABRIC_EVENTSTREAM_NAME=grizl-events
FABRIC_EVENTSTREAM_SOURCE_NAME=GRIZL-Source
FABRIC_EVENTHOUSE_NAME=grizl-house
FABRIC_KQL_DATABASE_NAME=grizl-house
FABRIC_KQL_RAW_TABLE_NAME=RawLogs
FABRIC_DASHBOARD_NAME=grizl-observability-dashboard
FABRIC_REFLEX_NAME="GRIZL Alerts"

# Set these after exporting or looking up live Fabric item IDs.
# They are non-secret identifiers, but are environment-specific.
FABRIC_WORKSPACE_ID=
FABRIC_EVENTSTREAM_ID=
FABRIC_EVENTHOUSE_ID=
FABRIC_KQL_DATABASE_ID=
FABRIC_KQL_QUERY_SERVICE_URI=
FABRIC_DASHBOARD_ID=
FABRIC_REFLEX_ID=
FABRIC_DATA_AGENT_ID=

# Non-secret Event Hubs-compatible identifiers shown in the Fabric Eventstream UI.
FABRIC_EVENTHUB_NAME=
FABRIC_EVENTHUB_SHARED_ACCESS_KEY_NAME=

# GCP/forwarder mapping. The connection string value is a secret and belongs in
# GCP Secret Manager under this secret name, not in this file.
GCP_SECRET_NAME_FABRIC_EVENTHUB_CONNECTION_STRING=FABRIC_EVENTHUB_CONNECTION_STRING
FORWARDER_ENV_FABRIC_EVENTHUB_CONNECTION_STRING=FABRIC_EVENTHUB_CONNECTION_STRING
FORWARDER_ENV_FABRIC_EVENTHUB_NAME=FABRIC_EVENTHUB_NAME
FORWARDER_ENV_FABRIC_EVENTSTREAM_PROTOCOL=FABRIC_EVENTSTREAM_PROTOCOL

# Data Agent scaffolding. Creation requires paid supported Fabric capacity
# (lowest-cost testing path: F2 pay-as-you-go, pause when not experimenting).
FABRIC_DATA_AGENT_NAME=grizl-incident-evidence-agent
FABRIC_DATA_AGENT_DESCRIPTION="GRIZL incident evidence assistant over Fabric Eventhouse/KQL observability data."
# Optional custom create payload. Leave blank to create a shell Data Agent from
# FABRIC_DATA_AGENT_NAME and FABRIC_DATA_AGENT_DESCRIPTION.
FABRIC_DATA_AGENT_PAYLOAD=

# Eventstream definition import. Export with items/<id>/getDefinition, then use
# import-eventstream-definition.sh to remap Eventhouse destination ids.
FABRIC_EVENTSTREAM_DEFINITION_FILE=fabric/manifests/eventstream.getDefinition.example.json
FABRIC_EVENTSTREAM_DESTINATION_CONNECTION_NAME=
FABRIC_EVENTSTREAM_DESTINATION_MAPPING_RULE_NAME=

# Data Agent staging endpoints.
FABRIC_DATA_AGENT_SETTINGS_FILE=fabric/manifests/data-agent-settings.example.json
FABRIC_DATA_AGENT_FEWSHOTS_FILE=fabric/manifests/data-agent-fewshots.example.json
FABRIC_DATA_AGENT_DATASOURCE_ID=
FABRIC_DATA_AGENT_ROOT_ID=
FABRIC_DATA_AGENT_ELEMENT_ID=

# Kusto management endpoint for RawLogs/functions setup. This is returned by
# the KQLDatabase item as queryServiceUri.
FABRIC_KQL_MGMT_COMMAND_FILE=
